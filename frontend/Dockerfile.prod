# ==========================================
# Production multi-stage build 
# ==========================================

# ==========================================
# Stage 1: Build React/Vite application
# ==========================================
FROM node:20-alpine AS build

WORKDIR /app

# Copy package files first to leverage Docker's caching system
COPY package*.json ./

# Install all dependencies (including Vite) needed to compile the code
RUN npm ci

# Copy the rest of your React project source code
COPY . .

# Run the Vite production build command. 
# This creates a folder called 'dist' with just raw HTML/JS/CSS
RUN npm run build


# ==========================================
# Stage 2: Production runtime
# ==========================================
# We throw away Node, and grab Nginx. It is tiny and super secure.
FROM nginx:alpine

# 2. Copy the compiled React "bento-boxes" from Stage 1 into Nginx's serving directory
COPY --from=build /app/dist /usr/share/nginx/html

# 3. Inject your custom traffic cop rulebook (nginx.conf) into Nginx's configuration folder
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Inform Docker that this container listens on standard HTTP port 80
EXPOSE 80

# Start Nginx in the foreground so the container stays alive and runs continuously
CMD ["nginx", "-g", "daemon off;"]